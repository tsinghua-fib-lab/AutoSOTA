{
  "output_dir": "__OUTPUT__",
  "summary": {
    "class": "ProteinGym",
    "path": "__DATA__",
    "csv_file": "DMS_substitutions.csv"
  },
  "structure_path": "__STRUCTURES__",
  "dataset": {
    "class": "DMSAssay",
    "atom_feature": null,
    "bond_feature": null,
    "transform": {
      "class": "Compose",
      "transforms": [
        {
          "class": "MutantStructure",
          "key": "graph",
          "template_key": "wild_type"
        },
        {
          "class": "ProteinView",
          "view": "residue"
        }
      ]
    }
  },
  "task": {
    "class": "ResidueTypePrediction",
    "mask_rate": 0.15,
    "dropout": 0.5,
    "plddt_threshold": 0,
    "esm_weight": 0.2,
    "wt_esm_weight": 0.3,
    "model": {
      "class": "FusionNetwork",
      "sequence_model": {
        "class": "MyESM",
        "path": "__ESM_WEIGHTS__",
        "model": "ESM-2-650M"
      },
      "structure_model": {
        "class": "GVPGNN",
        "node_in_dim": [
          1280,
          0
        ],
        "node_h_dim": [
          256,
          16
        ],
        "edge_in_dim": [
          16,
          1
        ],
        "edge_h_dim": [
          64,
          1
        ],
        "num_layers": 5,
        "vector_gate": true,
        "readout": "mean",
        "drop_rate": 0.25
      }
    },
    "graph_construction_model": {
      "class": "GraphConstruction",
      "node_layers": [
        {
          "class": "AlphaCarbonNode"
        }
      ],
      "edge_layers": [
        {
          "class": "SpatialEdge",
          "radius": 10.0,
          "min_distance": 0
        }
      ],
      "edge_feature": null
    }
  },
  "gpus": [
    0
  ],
  "batch_size": 4,
  "model_checkpoint": "__CHECKPOINT__"
}
