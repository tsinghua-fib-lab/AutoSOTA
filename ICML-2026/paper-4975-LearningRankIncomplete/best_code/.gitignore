# ---------------------------------------------------
# PIRATE Experiments .gitignore
# ---------------------------------------------------

# Type Checking
.mypy_cache/

# Python Cache and Bytecode
__pycache__/
*.py[cod]
*$py.class

# VSCode Workspace Settings
.vscode/

# Jupyter Notebooks (if you add plotting later)
.ipynb_checkpoints/

# Environments (prevents accidentally committing heavy env folders)
.env/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Outputs and Data (keeps the repo strictly for code)
results/
logs/
data/
*.csv
*.json
*.pdf
*.png
output/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---------------------------------------------------
# R Specific Files
# ---------------------------------------------------

# History and Workspace files
.RData
.Rhistory
.Rapp.history
.Ruserdata

# RStudio user-specific settings (if you ever open the folder in RStudio)
.Rproj.user/
*.Rproj

# R environment variables (often contains secrets or local system paths)
.Renviron

# Execution outputs and logs
*.Rout
*.Rout.save
*.Rout.fail

# R Markdown / knitr cache
/*_cache/

# Data directories and downloaded datasets
data/
ml-100k.zip
ml-100k/
*.csv

# LaTeX auxiliary files in rebuttal_figures
rebuttal_figures/*.aux
rebuttal_figures/*.fdb_latexmk
rebuttal_figures/*.fls
rebuttal_figures/*.log
rebuttal_figures/*.out
rebuttal_figures/*.synctex.gz

# Optional: Ignore the generated PDF if you only want the source in Git
# rebuttal_figures/*.pdf
