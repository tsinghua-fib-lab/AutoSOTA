# Copy to .env and fill in. .env is gitignored.

# Required for any run that uses OpenAI / GPT models.
OPENAI_API_KEY=

# Required for any run that uses Claude (Anthropic API or Bedrock).
ANTHROPIC_API_KEY=
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=

# Required for Gemini.
GEMINI_API_KEY=

# Optional: Together for hosted Llama/Qwen.
TOGETHER_API_KEY=

# Optional: where training will write tmp files / checkpoints if
# /run/user/<uid> is unavailable. Defaults to ~/.cache/discoverllm.
# RUN_USER_DIR=
