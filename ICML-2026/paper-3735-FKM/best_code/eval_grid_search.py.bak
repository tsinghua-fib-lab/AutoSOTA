"""
Paper 3735 eval - ITER-3: CODE-03 (Mixed NUFFT eps)
- eps=1e-7 for 1D NUFFT (30% faster than baseline)
- eps=1e-6 for 2D NUFFT
- Eigendecomposition + two-stage lambda search
"""
import warnings; warnings.filterwarnings("ignore")
import torch, cupy as cp, cufinufft, numpy as np, sys, json
from datetime import datetime

device = torch.device("cuda:0")
torch.set_default_dtype(torch.float64)

EPS_1D = 1e-7   # Optimal for 1D NUFFT based on benchmark
EPS_2D = 1e-6   # Optimal for 2D NUFFT based on benchmark

def NUFFT_Y(x_gpu, y_gpu, m):
    n = x_gpu.shape[0]
    f_gpu = cufinufft.nufft1d1(x_gpu, y_gpu, (2*m+1,), eps=EPS_1D)/n
    return torch.utils.dlpack.from_dlpack(f_gpu)

def kernel_vect(x1_gpu, x2_gpu, m):
    n = x1_gpu.shape[0]
    y_gpu = cp.ones(n).astype(cp.complex128)
    f_gpu = cufinufft.nufft2d1(x1_gpu, x2_gpu, y_gpu, (2*m+1,2*m+1), eps=EPS_2D)/n
    return torch.utils.dlpack.from_dlpack(f_gpu)

def NUFFT_inv(x_gpu, f_gpu):
    y_estimated = cufinufft.nufft1d2(x_gpu, f_gpu, eps=EPS_1D)
    return torch.utils.dlpack.from_dlpack(y_estimated)

def validate_lambda(hat_theta, x_val, y_val, N_val, d, m):
    estimator_val = cp.zeros(N_val, dtype=cp.float64)
    for dim in range(d):
        estimator_val += torch.real(NUFFT_inv(x_val[dim], hat_theta[(2*m+1)*dim:(2*m+1)*(dim+1)]))
    return float(cp.mean(cp.square(cp.abs(estimator_val - y_val))).get())

print("=" * 60)
print("Paper 3735 - ITER-3: Mixed NUFFT eps (1D={:.0e}, 2D={:.0e})".format(EPS_1D, EPS_2D))
print("Hardware: {}".format(torch.cuda.get_device_name(0)))
print("=" * 60)

cp.random.seed(seed=1); torch.manual_seed(1)

d = 5; s = 2
lambda_N_list = [10**(-j/10) for j in range(300)]
N = 100_000_000
m = 1 + int(N**(1/(2*s+1))/d); M = 2*m + 1
print("m={}, M={}, d*M={}".format(m, M, d*M))

# Generate data
print("Generating training data...")
x_gpu = cp.random.uniform(size=(d, N), dtype=cp.float64)
f_gpu = cp.zeros(N, dtype=cp.float64)
for dim in range(d):
    f_gpu += cp.exp(x_gpu[dim]/(dim+1)) - 1
y_gpu = f_gpu.astype(cp.complex128) + cp.random.normal(size=N).astype(cp.complex128)

N_val = min(N, 10**4)
x_val = cp.random.uniform(size=(d, N_val), dtype=cp.float64)
f_val = cp.zeros(N_val, dtype=cp.float64)
for dim in range(d):
    f_val += cp.exp(x_val[dim]/(dim+1)) - 1
y_val = f_val.astype(cp.complex128) + cp.random.normal(size=N_val).astype(cp.complex128)

print("Computing NUFFT transforms...")
sys.stdout.flush()

torch.cuda.synchronize()
start_event = torch.cuda.Event(enable_timing=True)
end_event = torch.cuda.Event(enable_timing=True)
start_event.record()

# cov_y via 1D NUFFT (eps=1e-7)
cov_y = torch.empty(d * M, dtype=torch.complex128, device=device)
for dim in range(d):
    cov_y[dim*M:(dim+1)*M] = NUFFT_Y(x_gpu[dim], y_gpu, m)

# cov_x via 2D NUFFT (eps=1e-6)
cov_x = torch.empty((d * M, d * M), dtype=torch.complex128, device=device)
for i1 in range(d):
    for i2 in range(i1, d):
        cov_x[i1*M:(i1+1)*M, i2*M:(i2+1)*M] = kernel_vect(x_gpu[i1], -x_gpu[i2], m)
        if i1 != i2:
            cov_x[i2*M:(i2+1)*M, i1*M:(i1+1)*M] = cov_x[i1*M:(i1+1)*M, i2*M:(i2+1)*M].conj().T

# Eigendecomposition
print("Eigendecomposing cov_x...")
sys.stdout.flush()
eigenvalues, eigenvectors = torch.linalg.eigh(cov_x)
eigenvalues = torch.clamp(eigenvalues, min=1e-30)
Vh_covy = eigenvectors.T.conj() @ cov_y

# Stage 1: Coarse search
print("Stage 1: Coarse search (30 lambdas)...")
sys.stdout.flush()
coarse_step = max(1, len(lambda_N_list) // 30)
coarse_indices = list(range(0, len(lambda_N_list), coarse_step))
if coarse_indices[-1] != len(lambda_N_list) - 1:
    coarse_indices.append(len(lambda_N_list) - 1)

best_coarse_mse = float("inf")
best_coarse_idx = 0
for idx in coarse_indices:
    lam = lambda_N_list[idx]
    inv_diag = 1.0 / (eigenvalues + lam)
    hat_theta = eigenvectors @ (inv_diag * Vh_covy)
    mse_val = validate_lambda(hat_theta, x_val, y_val, N_val, d, m)
    if mse_val < best_coarse_mse:
        best_coarse_mse = mse_val
        best_coarse_idx = idx

# Stage 2: Fine search
fine_radius = 10
fine_start = max(0, best_coarse_idx - fine_radius)
fine_end = min(len(lambda_N_list), best_coarse_idx + fine_radius + 1)
print("Stage 2: Fine search (indices {} to {})...".format(fine_start, fine_end-1))
sys.stdout.flush()

err_val = float("inf")
for idx in range(fine_start, fine_end):
    lam = lambda_N_list[idx]
    inv_diag = 1.0 / (eigenvalues + lam)
    hat_theta = eigenvectors @ (inv_diag * Vh_covy)
    mse_val = validate_lambda(hat_theta, x_val, y_val, N_val, d, m)
    if mse_val < err_val:
        err_val = mse_val
        hat_theta_best = hat_theta

n_validated = len(coarse_indices) + (fine_end - fine_start)

end_event.record()
torch.cuda.synchronize()
elapsed = start_event.elapsed_time(end_event) / 1e3
print("Total running time: {:.3f}s ({} lambdas validated)".format(elapsed, n_validated))

# Test evaluation
N_test = 10**4
x_test = cp.random.uniform(size=(d, N_test), dtype=cp.float64)
f_test = cp.zeros(N_test, dtype=cp.float64)
for dim in range(d):
    f_test += cp.exp(x_test[dim]/(dim+1)) - 1
y_test = f_test.astype(cp.complex128)

estimator = cp.zeros(N_test, dtype=cp.float64)
for dim in range(d):
    estimator += torch.real(NUFFT_inv(x_test[dim], hat_theta_best[(2*m+1)*dim:(2*m+1)*(dim+1)]))

mse = float(cp.mean(cp.square(cp.abs(estimator - y_test))).get())
print("Test MSE: {:.6e}".format(mse))

result = {
    "paper_id": 3735, "experiment": "additive_kernel_grid_search_mixed_eps",
    "parameters": {"d": d, "s": s, "n_lambda": len(lambda_N_list), "N": N,
                   "eps_1d": EPS_1D, "eps_2d": EPS_2D, "n_validated": n_validated,
                   "method": "eigendecomposition_twostage",
                   "hardware": torch.cuda.get_device_name(0)},
    "running_time_s": float(elapsed), "test_mse": float(mse),
    "timestamp": datetime.now().isoformat(),
}

with open("/repo/eval_result.json", "w") as f:
    json.dump(result, f, indent=2)

print("\n" + "=" * 60)
print("RESULT: running_time={:.3f}s, test_mse={:.6e}".format(elapsed, mse))
print("=" * 60)
