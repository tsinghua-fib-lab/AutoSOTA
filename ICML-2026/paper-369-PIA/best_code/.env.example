# Copy this file to the conventional local environment filename when running real API experiments.
# The default repository configuration runs in mock mode and does not require keys.

# OpenAI-compatible providers
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY = your_openai_api_key_here

SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_API_KEY = your_siliconflow_api_key_here

DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY = your_dashscope_api_key_here

DMXAPI_BASE_URL=https://api.dmxapi.com/v1
DMXAPI_API_KEY = your_dmxapi_api_key_here

NV_BASE_URL=https://integrate.api.nvidia.com/v1
NV_API_KEY = your_nvidia_api_key_here

# Local Ollama, if using an OpenAI-compatible local server
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY = ollama

# Runtime defaults
LOG_LEVEL=INFO
MOCK_MODE=true
DATASET_PATH=data/AdvBench/demo_harmful_behaviors_custom.csv
OUTPUT_DIR=./logs/cigt-smoke
ANALYSIS_DIR=./logs/analysis
IMAGES_DIR=./logs/images
