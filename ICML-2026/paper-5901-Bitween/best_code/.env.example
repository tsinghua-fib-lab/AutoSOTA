# Bitween / Learning Randomized Reductions — environment variables.
#
# Copy this file to `.env` and fill in the values you actually need.
# Only the symbolic-only path of V-Bitween (LR / PySR / GPLearn / PuLP-MILP)
# runs without any of these. Agentic Bitween needs at least one provider.

# ============================================================
# A-Bitween (LLM-agent variant) backends — pick ONE or both.
# ============================================================

# --- Option 1: AWS Bedrock (used for the paper's main numbers) -------------
# Requires `aws configure` with credentials that can call bedrock-runtime,
# or an `AWS_PROFILE` that does.
AWS_PROFILE=default
AWS_REGION=us-west-2
# Comma-separated model IDs you want available; the eval scripts pick by name.
# Examples (full IDs in https://docs.aws.amazon.com/bedrock/latest/userguide/inference-profiles-support.html):
#   us.anthropic.claude-opus-4-1-20250805-v1.0
#   us.anthropic.claude-sonnet-4-20250514-v1.0
#   openai.gpt-oss-120b-1:0
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1.0

# --- Option 2: OpenAI-compatible endpoint (vLLM, OpenAI, Together, etc.) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_MODEL=openai/gpt-oss-120b

# ============================================================
# Optional: Gurobi symbolic-MILP backend.
# ============================================================
# Skip unless you have a local Gurobi license -- PuLP/CBC fallback ships
# in this repo and is sufficient for all RSR-Bench results.
# GRB_LICENSE_FILE=/path/to/gurobi.lic

# ============================================================
# Logging / runtime knobs (optional).
# ============================================================
# Per-benchmark wall-clock cap, in seconds. Paper uses 1800.
BITWEEN_TIMEOUT=1800
# Where intermediate logs go.
BITWEEN_LOG_DIR=./logs
