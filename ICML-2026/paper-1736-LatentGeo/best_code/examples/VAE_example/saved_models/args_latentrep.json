{
	"train": {
        	"epochs": 6000,
        	"batch_size": 128,
        	"sampling": {
            		"std": 0.08
        	},
        	"lr": 0.001,
        	"weight_decay": 1e-05,
        	"seed": 42,
        	"device": "cuda:0"
	},
	"architecture": {
	        "intermediate_dim": 64,
	        "latent_dim": 2,
	        "depth": 4,
	        "activation": "elu",
	        "normalization" : false
	},
	"data": {
        	"load_path": "/path/to/data.npy",
        	"reach": 1
	},
	"test": {
	        "data": "path/to/data.npy",
	        "num_samples": 10000
	}
}
