# JiSi runtime keys. Keep real values in your local .env only.

# Embedding endpoint used by config/embedding_config*.yaml
EMBEDDING_API_KEY=your-embedding-api-key

# OpenAI-compatible generation endpoints used by api_config*.json
OPENAI_API_KEY=your-openai-api-key

# Optional evaluator/grader endpoint
GRADER_MODEL_NAME=gpt-4.1-mini
GRADER_BASE_URL=https://api.openai.com/v1
GRADER_API_KEY=your-grader-api-key

# Optional ArenaHard pairwise judge endpoint
ARENA_GRADER_MODEL_NAME=gpt-4.1-mini
ARENA_GRADER_BASE_URL=https://api.openai.com/v1
ARENA_GRADER_API_KEY=your-arena-grader-api-key

# Optional MySQL cache backend
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
