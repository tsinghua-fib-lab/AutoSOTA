namespace __f2_detail {
bool X_cond(double a2, double a3, double a4) {
    const double sq3 = std::sqrt(3.0);
    // Linear condition:
    // a2 > 0, a3 > 0, a4 > 0
    // a4 <= 1 + (2/sqrt(3) - 1) * a3
    // a3 + a4 >= 1
    double rhs = 1.0 + (2.0 / sq3 - 1.0) * a3;
    if (a4 > rhs) return false;
    if (a3 + a4 < 1.0) return false;
    return true;
}

double AX_upper_bound(double a2, double a3, double a4) {
    const double sq3 = std::sqrt(3.0);
    // Distances from A0 to polygon vertices A1, A2, A3, A4, H.
    double d1 = 1.0;
    double d2 = std::sqrt(1.0 + a2 + a2 * a2);
    double d3 = std::sqrt(1.0 + a2 + a2 * a2 - a3 + a2 * a3 + a3 * a3);
    double d4 = std::sqrt(a2 * a2 + a3 * a3
                          + a2 * (1.0 + a3 - a4)
                          + a3 * (-1.0 + a4)
                          + ( -1.0 + a4) * ( -1.0 + a4));
    // Under cond we ensured a3 + a4 >= 1, so |OH| = (sqrt(3)/2)*(a3 + a4 - 1)
    double dH = (sq3 / 2.0) * (a3 + a4 - 1.0);

    return std::max({d1, d2, d3, d4, dH});
}

