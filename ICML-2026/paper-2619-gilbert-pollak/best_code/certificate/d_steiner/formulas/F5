bool X_cond(double a2, double a3, double a4) {
    // Linear sufficient condition ensuring trapping via B(2,4) with s=3.
    return a4 < (2 / std::sqrt(3.0) - 1) * a3;
}

double AX_upper_bound(double a2, double a3, double a4) {
    // Distances from A0 to polygon vertices A2, A3, A4.
    double d2 = std::sqrt(1.0 + a2 + a2 * a2);
    double d3 = std::sqrt(1.0 + a2 + a2 * a2 - a3 + a2 * a3 + a3 * a3);
    double d4 = std::sqrt(a2 * a2 + a3 * a3
                          + a2 * (1.0 + a3 - a4)
                          + a3 * (-1.0 + a4)
                          + ( -1.0 + a4) * ( -1.0 + a4));
    return std::max({d2, d3, d4});
}

double DX_upper_bound(double a2, double a3, double a4, double d) {
    // Distances from D to polygon vertices A2, A3, A4, H.
    double d2 = d;
    double d3 = std::sqrt(a3 * a3 + a3 * d + d * d);
    double d4 = std::sqrt((a4 + d) * (a4 + d) + (a4 + d) * a3 + a3 * a3);
    double dH = std::sqrt(0.75 * (a3 + a4) * (a3 + a4) + 1.5 * (a3 + a4) * d + d * d);
    return std::max({d2, d3, d4, dH});
}

double UX_upper_bound(double a2, double a3, double a4, double t, double c) {
    return DX_upper_bound(a2, a3, a4, t) + c;
    // Distances from C to polygon vertices A2, A3, A4, H.
    double d2 = std::sqrt(c*c + c*t + t*t);
    double d3 = std::sqrt(c*c + c*t + 2*c*a3 + t*t + t*a3 + a3*a3);
    double d4 = std::sqrt(c*c + c*a4 + c*t + 2*c*a3 + a4*a4 + 2*a4*t + a4*a3 + t*t + t*a3 + a3*a3);
    double dH = std::sqrt(c*c + 3*c*a4/2 + c*t + 3*c*a3/2 + 3*a4*a4/4 + 3*a4*t/2 + 3*a4*a3/2 + t*t + 3*t*a3/2 + 3*a3*a3/4);
    return std::max({d2, d3, d4, dH});
}

double VX_upper_bound(double a2, double a3, double a4, double t, double d) {
    return DX_upper_bound(a2, a3, a4, t) + d;
    // Distances from D to polygon vertices A2, A3, A4, H.
    double d2 = std::sqrt(d*d + d*t + t*t);
    double d3 = std::sqrt(d*d + d*t - d*a3 + t*t + t*a3 + a3*a3);
    double d4 = std::sqrt(d*d + d*a4 + d*t - d*a3 + a4*a4 + 2*a4*t + a4*a3 + t*t + t*a3 + a3*a3);
    double dH = std::sqrt(d*d + d*t + 3*a4*a4/4 + 3*a4*t/2 + 3*a4*a3/2 + t*t + 3*t*a3/2 + 3*a3*a3/4);
    return std::max({d2, d3, d4, dH});
}

