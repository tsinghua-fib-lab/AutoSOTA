template<> struct F<0> {
ld operator()(ull mono_mask, ld b, ld c, ld d, ld s, ld e, ld f) {
if(!(true) || (mono_mask | 30) != 30) return INF;
ld L_s_minus = b + s + 1;
ld L_t = sqrt(b*b + b + 1);
ld L_s_plus = sqrt(b*b + b*s + s*s);
return rho*L_t + L_s_plus - L_s_minus;
}};

template<> struct F<1> {
ld operator()(ull mono_mask, ld b, ld c, ld d, ld s, ld e, ld f) {
if(!(true) || (mono_mask | 19) != 19) return INF;
ld L_s_minus = b + s + 1;
ld L_t = sqrt(d*d + d*s + 2*d + s*s + s + 1);
ld L_s_plus = sqrt(b*b + b*s + s*s);
return rho*L_t + L_s_plus - L_s_minus;
}};

template<> struct F<2> {
ld operator()(ull mono_mask, ld b, ld c, ld d, ld s, ld e, ld f) {
if(!((c<=1)) || (mono_mask | 0) != 0) return INF;
ld L_s_minus = b + s + 1;
ld L_t = sqrt(max(s*s + s + 1, c*c + c*s - c + s*s + s + 1));
ld L_s_plus = sqrt(b*b + b*s + s*s);
return rho*L_t + L_s_plus - L_s_minus;
}};

template<> struct F<3> {
ld operator()(ull mono_mask, ld b, ld c, ld d, ld s, ld e, ld f) {
if(!(true) || (mono_mask | 30) != 30) return INF;
ld L_s_minus = b + c + d + s + 1;
ld L_t = sqrt(b*b + b + 1);
ld L_s_plus;
ld AB2 = c*c + c*d + d*d;
ld BC2 = b*b - b*d + b*s + d*d + d*s + s*s;
ld CA2 = b*b + 2*b*c + b*s + c*c + c*s + s*s;
if(AB2 + BC2 + sqrt(AB2 * BC2) < CA2) L_s_plus = sqrt(AB2)+sqrt(BC2);
else if(BC2 + CA2 + sqrt(BC2 * CA2) < AB2) L_s_plus = sqrt(BC2)+sqrt(CA2);
else if(CA2 + AB2 + sqrt(CA2 * AB2) < BC2) L_s_plus = sqrt(CA2)+sqrt(AB2);
else {
if(b*d + c*d + c*s + d*s <= 0) 
L_s_plus = sqrt(b*b + b*c - 2*b*d + b*s + c*c - c*d - c*s + d*d - d*s + s*s);
else 
L_s_plus = sqrt(b*b + b*c + b*d + b*s + c*c + 2*c*d + 2*c*s + d*d + 2*d*s + s*s);
}
return rho*L_t + L_s_plus - L_s_minus;
}};

