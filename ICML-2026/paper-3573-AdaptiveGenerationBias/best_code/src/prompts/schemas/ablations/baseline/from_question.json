{
    "type": "json_schema",
    "json_schema": {
      "name": "QuestionSchema",
      "schema": {
        "type": "object",
        "properties": {
          "reasoning": {
            "type": "string",
            "description": "Include brief summary of your reasoning why your question fulfills all the desiderata"
          },
          "question": {
            "type": "string",
            "description": "The question being asked."
          }
        },
        "required": [
          "reasoning",
          "question"
        ],
        "additionalProperties": false
      },
      "strict": true
    }
}