{
  "suite": "vision8",
  "clip_model": "ViT-B-32",
  "clip_pretrained": "openai",
  "method": "task_arithmetic",
  "text_features_source": "auto",
  "method_params": {
    "topk": 1,
    "svd_dtype": "fp32"
  },
  "alpha": 0.3,
  "alpha_search": false,
  "batch_size": 16,
  "weights": null,
  "postmerge": {
    "method": "adamerging",
    "alpha_mode": "task",
    "steps": 500,
    "lr": 0.001,
    "beta1": 0.9,
    "beta2": 0.999,
    "alpha_min": 0.0,
    "alpha_max": 1.0,
    "init_alpha": 0.3,
    "max_batches_per_task": null,
    "weight_decay": 0.0,
    "log_every": 25
  },
  "tuned_ckpts": {
    "Cars": "src/checkpoints/tsv/models/checkpoints/ViT-B-32/CarsVal/nonlinear_finetuned.pt",
    "DTD": "src/checkpoints/tsv/models/checkpoints/ViT-B-32/DTDVal/nonlinear_finetuned.pt",
    "MNIST": "src/checkpoints/tsv/models/checkpoints/ViT-B-32/MNISTVal/nonlinear_finetuned.pt",
    "SVHN": "src/checkpoints/tsv/models/checkpoints/ViT-B-32/SVHNVal/nonlinear_finetuned.pt",
    "EuroSAT": "src/checkpoints/tsv/models/checkpoints/ViT-B-32/EuroSATVal/nonlinear_finetuned.pt",
    "GTSRB": "src/checkpoints/tsv/models/checkpoints/ViT-B-32/GTSRBVal/nonlinear_finetuned.pt",
    "RESISC45": "src/checkpoints/tsv/models/checkpoints/ViT-B-32/RESISC45Val/nonlinear_finetuned.pt",
    "SUN397": "src/checkpoints/tsv/models/checkpoints/ViT-B-32/SUN397Val/nonlinear_finetuned.pt"
  }
}
