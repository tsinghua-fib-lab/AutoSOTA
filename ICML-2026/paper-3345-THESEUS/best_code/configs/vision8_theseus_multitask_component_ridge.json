{
  "suite": "vision8",
  "tasks": "all",
  "source_clip_model": "ViT-B-16",
  "source_clip_pretrained": "datacomp_xl_s13b_b90k",
  "target_clip_model": "ViT-L-14",
  "target_clip_pretrained": "datacomp_xl_s13b_b90k",
  "method": "theseus",
  "method_params": {
    "num_batches": 5,
    "seq_align": "interpolate2d",
    "split_qkv": true,
    "center_acts": false
  },
  "block_extension_enabled": true,
  "block_extension_params": {
    "blocks_to_add": null,
    "insertion_order": "bottom-top",
    "extension_density": "spread",
    "extension_strategy": "interpolate_per_weight",
    "dampening_factor": 1.0,
    "n_batches_act": 1,
    "calibration_split": "test",
    "skip_correction": false,
    "skip_final_ln": false,
    "verbose": false,
    "show_progress": false,
    "ridge_identity": 500.0,
    "n_cascade_iters": 1,
    "share_ft_refs": false,
    "component_ridge": {
      "ln_1": 5000,
      "ln_2": 5000,
      "q": 1000,
      "k": 1000,
      "v": 1000,
      "out_proj": 100,
      "c_proj": 100,
      "c_fc": 500
    }
  },
  "eval_before_rebase": true,
  "block_extension_eval_split": "test",
  "alpha_search": true,
  "alpha_selection": "shared",
  "alpha_min": 0,
  "alpha_max": 2.0,
  "alpha_step": 0.2,
  "alpha_patience": 3,
  "alpha_search_split": "test",
  "batch_size": 32,
  "num_workers": 0,
  "val_fraction": 0.1,
  "seed": 89,
  "no_humanize": true,
  "strict_load": false,
  "tuned_ckpts": {
    "Cars": "src/checkpoints/theseus/models/checkpoints/ViT-B-16/datacomp_xl_s13b_b90k/cars/best.pt",
    "DTD": "src/checkpoints/theseus/models/checkpoints/ViT-B-16/datacomp_xl_s13b_b90k/dtd/best.pt",
    "EuroSAT": "src/checkpoints/theseus/models/checkpoints/ViT-B-16/datacomp_xl_s13b_b90k/eurosat/best.pt",
    "GTSRB": "src/checkpoints/theseus/models/checkpoints/ViT-B-16/datacomp_xl_s13b_b90k/gtsrb/best.pt",
    "MNIST": "src/checkpoints/theseus/models/checkpoints/ViT-B-16/datacomp_xl_s13b_b90k/mnist/best.pt",
    "RESISC45": "src/checkpoints/theseus/models/checkpoints/ViT-B-16/datacomp_xl_s13b_b90k/resisc45/best.pt",
    "SUN397": "src/checkpoints/theseus/models/checkpoints/ViT-B-16/datacomp_xl_s13b_b90k/sun397/best.pt",
    "SVHN": "src/checkpoints/theseus/models/checkpoints/ViT-B-16/datacomp_xl_s13b_b90k/svhn/best.pt"
  }
