  "alpha_patience": 10,
  "alpha_search_split": "test",
  "batch_size": 32,
  "num_workers": 0,
  "val_fraction": 0.1,
  "seed": 89,
  "no_humanize": true,
  "weights": null,
  "strict_load": false,
  "tuned_ckpts": {
    "EuroSAT": "src/checkpoints/theseus/models/checkpoints/ViT-B-16/datacomp_xl_s13b_b90k/eurosat/best.pt"
  }
