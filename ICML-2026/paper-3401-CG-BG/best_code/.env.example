# example of file for storing private and user specific environment variables, like keys or system paths
# rename it to ".env" (excluded from version control by default)
# .env is loaded by main.py automatically
# hydra allows you to reference variables in .yaml configs with special syntax: ${oc.env:MY_VAR}

# sets where scratch is located
SCRATCH_DIR="/home/user/my/system/path"

# HuggingFace token — only needed for private/gated repos or uploading data.
# The default dataset (bojuntum/CGPeptides) is public; leave blank if using it.
# Get a token at: https://huggingface.co/settings/tokens
HF_TOKEN=""

# HuggingFace dataset repo — optional, defaults to bojuntum/CGPeptides.
# Set this only if you want to use a different repo.
# HF_REPO_ID="your-username/your-dataset"
