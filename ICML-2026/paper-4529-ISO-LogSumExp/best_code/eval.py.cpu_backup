#!/usr/bin/env python3
"""Reproduction evaluation for paper 4529 — Improved Stochastic Optimization of LogSumExp.

Reproduces Table 1: KL-DRO on California Housing, λ=5, |D|=10, ρ=1e-3.
Paper value: 0.76 ± 0.02. CI bounds: [0.74, 0.78].
"""
import sys, os, math
import numpy as np
import torch
import torch.nn as nn
import torch.nn.functional as F
from torch.utils.data import DataLoader, TensorDataset
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LinearRegression

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
def get_data():
    """Load California Housing data. Downloads from OpenML if not cached."""
    data_path = '/datasets/california_housing_data.npy'
    target_path = '/datasets/california_housing_target.npy'

    if os.path.exists(data_path) and os.path.exists(target_path):
        X = np.load(data_path)
        y = np.load(target_path)
        return X, y

    # Download from OpenML
    from sklearn.datasets import fetch_openml
    housing = fetch_openml(name='california_housing', version=1, as_frame=False, parser='auto')

    numeric_cols = [0, 1, 2, 3, 4, 5, 6, 7]  # skip ocean_proximity
    raw = housing.data[:, numeric_cols].astype(float)
    longitude = raw[:, 0]
    latitude = raw[:, 1]
    housing_median_age = raw[:, 2]
    total_rooms = raw[:, 3]
    total_bedrooms = raw[:, 4]
    population = raw[:, 5]
    households = raw[:, 6]
    median_income = raw[:, 7]

    target = housing.target.astype(float) / 100_000.0

    # Impute missing total_bedrooms
    total_bedrooms_clean = total_bedrooms.copy()
    nan_mask = np.isnan(total_bedrooms_clean)
    total_bedrooms_clean[nan_mask] = np.nanmedian(total_bedrooms_clean)

    # Derived features (matching sklearn's fetch_california_housing)
    ave_rooms = total_rooms / households
    ave_bedrms = total_bedrooms_clean / households
    ave_occup = population / households

    X = np.column_stack([
        median_income, housing_median_age, ave_rooms, ave_bedrms,
        population, ave_occup, latitude, longitude
    ])

    # Cache for reuse
    os.makedirs('/datasets', exist_ok=True)
    np.save(data_path, X)
    np.save(target_path, target)
    return X, target

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
class LinRegModel(nn.Module):
    def __init__(self, input_dim, with_alpha=False):
        super().__init__()
        self.linear = nn.Linear(input_dim, 1)
        sd = torch.load('/repo/linreg_weights.pt')
        with torch.no_grad():
            self.linear.weight.copy_(sd['weights'].unsqueeze(0))
            self.linear.bias.copy_(sd['bias'])
        if with_alpha:
            self.alpha = nn.Parameter(torch.zeros(()))
    def forward(self, x):
        return self.linear(x)

# ---------------------------------------------------------------------------
# Objective
# ---------------------------------------------------------------------------
def compute_objective(model, X, y, lam):
    with torch.no_grad():
        preds = model(X)
        errors = (preds - y) ** 2
        L = errors.squeeze(1)
    lse = torch.logsumexp(L / lam, dim=0).item() - math.log(len(y))
    return lam * lse

# ---------------------------------------------------------------------------
# Training
# ---------------------------------------------------------------------------
def train_one_run(dataset, X, y, lam, rho, lr, seed, batch_size=10, n_epochs=50):
    torch.manual_seed(seed)
    loader = DataLoader(dataset, batch_size=batch_size, shuffle=True)

    model = LinRegModel(X.shape[1], with_alpha=(rho is not None))
    optimizer = torch.optim.SGD(model.parameters(), lr=lr, momentum=0.9, nesterov=True)

    for epoch in range(1, n_epochs + 1):
        for Xb, yb in loader:
            optimizer.zero_grad()
            preds = model(Xb)
            errors = (preds - yb) ** 2
            L = errors.squeeze(1)

            if rho is None:  # baseline
                with torch.no_grad():
                    p = torch.softmax(L / lam, dim=0)
                loss = torch.sum(p * L)
            else:  # proposed
                exponent = (L - model.alpha) / lam + math.log(rho)
                loss = (lam / rho) * F.softplus(exponent).mean() + model.alpha

            loss.backward()
            optimizer.step()

    return compute_objective(model, X, y, lam)

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def main():
    print("=== Paper 4529 Reproduction: KL-DRO on California Housing ===")
    print("Configuration: lambda=5, |D|=10, rho=1e-3")

    # Load/prepare data
    X_np, y_np = get_data()
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X_np)
    tX = torch.from_numpy(X_scaled.astype(np.float32))
    ty = torch.from_numpy(y_np.astype(np.float32)).unsqueeze(1)
    dataset = TensorDataset(tX, ty)
    print(f"Data: {len(dataset)} samples, {X_scaled.shape[1]} features")

    # Save least squares init
    lr_model = LinearRegression(fit_intercept=True).fit(X_scaled, y_np)
    w = torch.tensor(lr_model.coef_, dtype=torch.float32)
    b = torch.tensor(lr_model.intercept_, dtype=torch.float32)
    torch.save({'weights': w, 'bias': b}, '/repo/linreg_weights.pt')

    X, Y = dataset.tensors
    lam = 5.0
    rho = 1e-3
    n_seeds = 10

    # Grid search over learning rates (paper grid: {1e-9,...,1e-4})
    print("\n--- Grid search for optimal learning rate ---")
    lr_candidates = [1e-7, 3e-7, 5e-7, 7e-7, 1e-6]
    best_lr = None
    best_mean = float('inf')
    all_results = {}

    for lr in lr_candidates:
        results = []
        failed = 0
        for seed in range(n_seeds):
            try:
                obj = train_one_run(dataset, X, Y, lam, rho, lr, seed)
                if np.isfinite(obj):
                    results.append(obj)
                else:
                    failed += 1
            except Exception:
                failed += 1

        if results:
            m = np.mean(results)
            s = np.std(results)
            print(f"  lr={lr:.0e}: {m:.4f} +/- {s:.4f}  ({len(results)}/{n_seeds} ok, {failed} failed)")
            all_results[lr] = (m, s, len(results), failed)
            if len(results) == n_seeds and m < best_mean:
                best_mean = m
                best_lr = lr

    # Final evaluation with best LR
    print(f"\n--- Final evaluation (lr={best_lr}) ---")
    final_results = []
    for seed in range(n_seeds):
        obj = train_one_run(dataset, X, Y, lam, rho, best_lr, seed)
        final_results.append(obj)

    final_mean = np.mean(final_results)
    final_std = np.std(final_results)

    # Baseline
    print(f"\n--- Baseline ---")
    baseline_results = []
    for seed in range(n_seeds):
        obj = train_one_run(dataset, X, Y, lam, None, 1e-6, seed)
        baseline_results.append(obj)
    baseline_mean = np.mean(baseline_results)
    baseline_std = np.std(baseline_results)

    # Report
    print(f"\n{'='*60}")
    print(f"REPRODUCTION RESULT")
    print(f"{'='*60}")
    print(f"  Proposed (rho=1e-3, lr={best_lr}): {final_mean:.4f} +/- {final_std:.4f}")
    print(f"  Paper value: 0.76 +/- 0.02")
    print(f"  CI bounds: [0.74, 0.78]")
    print(f"  Within bounds: {0.74 <= final_mean <= 0.78}")
    print(f"  Baseline: {baseline_mean:.4f} +/- {baseline_std:.4f}  [paper: 0.87 +/- 0.01]")

    # Output machine-parseable line
    print(f"\nMETRIC:proposed_objective={final_mean:.4f}")
    print(f"METRIC:proposed_std={final_std:.4f}")
    print(f"METRIC:baseline_objective={baseline_mean:.4f}")
    print(f"METRIC:baseline_std={baseline_std:.4f}")

if __name__ == "__main__":
    main()
