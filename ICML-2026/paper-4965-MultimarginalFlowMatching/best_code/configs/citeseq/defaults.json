{
    "_description": "Default configuration for CITE-seq 50D PCA dataset training.",
    "data_dir": "OTP-FM/data",
    "pca_dim": 50,
    "normalize": true,
    "ot_coupling": true,
    "ot_method": "emd",
    "batch_size": 256,
    "val_split": 0.1,
    "hidden_dim": 768,
    "num_hidden_layers": 10,
    "x_hidden_layers": 0,
    "t_hidden_layers": 0,
    "x_emb_dim": 64,
    "t_emb_dim": 64,
    "activation": "silu",
    "layernorm": true,
    "dropout": 0.2,
    "residual_every": 2,
    "potential": "w2inf",
    "tks": [
        0.5
    ],
    "strength": 500.0,
    "lambda_type": "delta",
    "lambda_width": 0.33,
    "epochs": 200,
    "lr": 0.003,
    "lr_schedule": "cosine",
    "optimizer": "adam",
    "grad_clip": 0.0,
    "reshuffle_each_epoch": true,
    "consistency_loss": "meanflow",
    "lossfn": "adaptive",
    "time_sampler": "uniform_scaled_marginal",
    "diag_prob": 0.75,
    "euler_steps": 2,
    "ema_decay": 0.99,
    "ema_ot": true,
    "jvp_clamp": 100.0,
    "solver_type": null,
    "picard_steps": 5,
    "sampling_steps": 100,
    "eval_n_steps": 100,
    "eval_num_samples": null,
    "eval_metrics": [
        "w1",
        "swd",
        "mmd",
        "w2"
    ],
    "traj_skips": 20,
    "num_1d_plot_samples": 5,
    "otp_alpha_type": "sigmoid",
    "otp_alpha_slope": 24.0,
    "otp_alpha_mean_scale": 0.5,
    "seed": 42,
    "debug": false,
    "weight_decay": 0.0
}
