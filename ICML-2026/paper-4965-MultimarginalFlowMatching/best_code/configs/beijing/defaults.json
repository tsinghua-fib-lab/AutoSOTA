{
    "_description": "Default configuration for Beijing air quality PM2.5 dataset training.",

    "data_dir": "data/beijing",
    "normalize": true,
    "ot_coupling": true,
    "ot_method": "emd",
    "train_times": [0, 1, 3, 4, 6, 7, 9, 10, 12],
    "holdout_times": [2, 5, 8, 11],
    "batch_size": 128,
    "val_split": 0.0,

    "hidden_dim": 128,
    "num_hidden_layers": 4,
    "x_hidden_layers": 0,
    "t_hidden_layers": 0,
    "x_emb_dim": 64,
    "t_emb_dim": 64,
    "activation": "silu",
    "layernorm": true,
    "dropout": 0.0,
    "residual_every": 2,

    "potential": "w2inf",
    "tks": [0.0833, 0.25, 0.333, 0.5, 0.5833, 0.75, 0.8333],
    "strength": 10.0,
    "strengths": null,
    "lambda_type": "box",
    "width": 0.08,
    "widths": null,
    "mmd_bandwidth": [3.0],
    "kl_rho_method": "kde",
    "kl_mu_method": null,
    "kl_bandwidth": "3.0",
    "kl_bandwidth_scale": 2.5,
    "kl_n_projections": 64,
    "kl_ssge_eta": 0.01,
    "kl_diagonal_cov": false,

    "epochs": 600,
    "lr": 0.003,
    "optimizer": "adam",
    "grad_clip": 0.0,
    "reshuffle_each_epoch": true,

    "consistency_loss": "imf",
    "lossfn": "mse",
    "time_sampler": "uniform_scaled_marginal",
    "diag_prob": 0.75,
    "euler_steps": 2,
    "ema_decay": 0.99,
    "ema_ot": true,
    "jvp_clamp": 100.0,
    "solver_type": null,
    "picard_steps": 5,
    "time_loss_weight": "uniform",
    "time_loss_alpha": 1.0,
    "adaptive_exp": 1.0,
    "time_bias_alpha": 2.0,
    "time_bias_beta": 1.0,
    "traj_consistency_weight": 0.0,
    "traj_consistency_steps": 5,
    "trajectory_noise": 0.0,

    "sampling_steps": 20,
    "eval_n_steps": 20,
    "eval_num_samples": 1000,
    "num_plot_trajectories": 1000,
    "traj_skips": null,
    "num_1d_plot_samples": 5,

    "otp_alpha_type": "sigmoid",
    "otp_alpha_slope": 6.0,
    "otp_alpha_mean_scale": 0.0,

    "seed": 42,
    "debug": false
}
