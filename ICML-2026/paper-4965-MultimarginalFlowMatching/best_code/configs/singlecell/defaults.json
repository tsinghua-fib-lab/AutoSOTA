{
    "_description": "Default configuration for single-cell EB dataset training",

    "data_dir": "data",
    "pca_dim": 100,
    "normalize": true,
    "ot_coupling": true,
    "ot_method": "emd",
    "ot_reg": 0.0,
    "holdout_times": [1, 3],
    "batch_size": 256,
    "val_split": 0.1,

    "hidden_dim": 768,
    "num_hidden_layers": 8,
    "x_hidden_layers": 0,
    "t_hidden_layers": 0,
    "x_emb_dim": 64,
    "t_emb_dim": 64,
    "activation": "silu",
    "layernorm": true,
    "dropout": 0.2,
    "residual_every": 2,

    "potential": "w2inf",
    "tks": [0.5],
    "strength": 100.0,
    "lambda_type": "gaussian",
    "lambda_width": 0.33,
    "mmd_bandwidth": [3.0],
    "entropic_reg": 0.01,
    "entropic_max_iter": 100,
    "kl_rho_method": "kde",
    "kl_mu_method": null,
    "kl_bandwidth": "3.0",
    "kl_bandwidth_scale": 2.5,
    "kl_n_projections": 64,
    "kl_ssge_eta": 0.01,
    "kl_diagonal_cov": false,

    "epochs": 300,
    "lr": 0.003,
    "optimizer": "adam",
    "grad_clip": 0.0,
    "reshuffle_each_epoch": true,

    "consistency_loss": "meanflow",
    "lossfn": "adaptive",
    "time_sampler": "uniform_scaled_marginal",
    "diag_prob": 0.75,
    "euler_steps": 2,
    "ema_decay": 0.99,
    "ema_ot": true,
    "jvp_clamp": 100.0,
    "solver_type": null,
    "picard_steps": 5,

    "sampling_steps": 50,
    "sampling_method": "consistency",
    "eval_n_steps": 50,
    "eval_num_samples": 2000,
    "num_plot_trajectories": 0,
    "traj_skips": 20,
    "num_1d_plot_samples": 5,

    "otp_alpha_type": "sigmoid",
    "otp_alpha_slope": 6.0,
    "otp_alpha_mean_scale": 0.5,

    "seed": 42,
    "debug": false
}
