data:
  datapath: data/test/poisson/poisson.mat
  name: Poisson_fourier
  offset: 0
generate:
  batch_size: 1
  beta1: 0.985
  beta2: 0.98
  device: cuda
  freq_transition: 10
  lr_high: 0.01
  lr_low: 0.2
  obs_a: 0
  obs_u: 500
  rho: 7
  seed: 0
  sigma_max: 70
  sigma_min: 0.002
  strategy: hyperbolic_44
  zeta_obs_a: 0
  zeta_obs_u: 50
  zeta_pde: 5.0e-05
test:
  iterations: 2000
  pre-trained: trained_models/pretrained-poisson_hyperbolic_44-fourier.pkl
