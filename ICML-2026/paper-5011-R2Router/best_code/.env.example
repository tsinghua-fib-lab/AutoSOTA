# R2-Router environment configuration
#
# For single-query routing (route.py), no environment variables are needed.
# Just download checkpoints to ./r2_router/ or use --hf-repo.
#
# The variables below are ONLY needed for batch reproduction
# (reproduce/routerarena.sh) which re-runs the full RouterArena evaluation.

# === Required for batch reproduction ===

# Budget sweep data: per-model, per-budget evaluation results
R2_SWEEP_ROOT=/path/to/routerarena_data_release/budget_sweep

# Consolidated training data (embeddings + labels for all 8400 queries)
R2_TRAINING_DATA_PATH=/path/to/routerarena_data_release/category_router/training_data.pkl

# RouterArena metadata
R2_ROUTER_DATA_PATH=/path/to/routerarena_data_release/routerarena_meta/router_data.json
R2_ROUTER_DATA_10_PATH=/path/to/routerarena_data_release/routerarena_meta/router_data_10.json
R2_MODEL_COST_PATH=/path/to/routerarena_data_release/routerarena_meta/model_cost.json
